<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>bas-api-2026</UserSecretsId>
    <!-- Project directory is Api (src/ layout, mirroring PracticeManager.Api); the assembly and
         namespaces carry the fully-qualified name, which is also the container entrypoint. -->
    <AssemblyName>Bas.Api</AssemblyName>
    <RootNamespace>Bas.Api</RootNamespace>
    <!-- The integration tests drive the real pipeline through WebApplicationFactory, which needs
         the entry point to be reachable. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Versions live in Directory.Packages.props, including the rationale comments for the
       EntityFrameworkCore.Relational pin and the PracticeManager.Api.Contracts float. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Keeps the Data Protection key ring in Postgres. Without it the keys live inside the
         container, so every redeploy invalidates every antiforgery token and every auth cookie. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- /health checks the database; without it the endpoint reported healthy with Postgres down,
         and the container healthcheck plus Caddy were watching an answer that meant nothing. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Renders the OpenAPI document as browsable reference docs at /docs, with a request builder.
         What a partner's engineer opens before they write anything. -->
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- The gRPC contract for the Practice Manager push, from GitHub Packages. -->
    <PackageReference Include="PracticeManager.Api.Contracts" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bas.Api.Tests" />
  </ItemGroup>

</Project>
