@page "/admin/partners/{ClientId}/key"
@attribute [Authorize(Policy = AdminEndpoints.UiPolicyName)]
@inject AdminService Admin

<a href="/admin/partners" class="text-sm text-zinc-500 hover:text-zinc-900">&larr; Partners</a>

@if (_partner is null && _result is null)
{
    <p class="mt-4 text-sm text-zinc-500">No partner with client id <span class="font-mono">@ClientId</span>.</p>
}
else if (_result is null)
{
    <h1 class="text-lg font-semibold tracking-tight text-zinc-900 mt-3 mb-1">
        New key for @_partner!.ClientId
    </h1>
    <p class="text-sm text-zinc-500 mb-6 max-w-xl">
        Current key: <span class="font-mono text-xs">@(_partner.ApiKeyPrefix is null ? "none issued" : _partner.ApiKeyPrefix + "…")</span>
    </p>

    <div class="max-w-xl bg-white border border-zinc-200/70 rounded-xl p-5">
        <p class="text-sm text-zinc-700 m-0 mb-4">
            The old key stops working the moment this is issued, so their calls fail until they
            switch. Coordinate with them first — unless this is a response to a leak, in which case
            that is the point.
        </p>

        <EditForm Model="this" FormName="rotate" OnValidSubmit="RotateAsync">
            <button type="submit"
                    class="px-3 py-2 text-sm font-medium text-white bg-zinc-900 rounded-md hover:bg-zinc-800 transition-colors">
                Issue new key
            </button>
        </EditForm>

        @if (_error is not null)
        {
            <p class="text-sm text-red-600 mt-3 mb-0">@_error</p>
        }
    </div>
}
else
{
    <h1 class="text-lg font-semibold tracking-tight text-zinc-900 mt-3 mb-1">
        New key for @_result.Partner.ClientId
    </h1>
    <p class="text-sm text-zinc-500 mb-6 max-w-xl">The previous key is refused from now.</p>

    <div class="max-w-2xl bg-white border border-amber-300 rounded-xl overflow-hidden">
        <div class="px-5 py-3 bg-amber-50 border-b border-amber-200">
            <p class="text-sm font-semibold text-amber-900 m-0">Copy it now — it is not stored</p>
            <p class="text-xs text-amber-800 mt-1 mb-0">
                Send it over a channel you trust. It belongs on their servers only.
            </p>
        </div>
        <div class="p-5">
            <input readonly id="apiKey" value="@_result.ApiKey"
                   class="w-full font-mono text-xs p-2.5 bg-zinc-50 border border-zinc-200 rounded-md" />
            <button type="button" id="copyKey"
                    class="mt-3 px-2.5 py-1.5 text-xs font-medium rounded-md border border-zinc-200 text-zinc-600
                           hover:text-zinc-900 hover:border-zinc-300 hover:bg-zinc-50 transition-colors">
                Copy
            </button>
        </div>
    </div>

    <script>
        document.getElementById('copyKey').addEventListener('click', async event => {
            await navigator.clipboard.writeText(document.getElementById('apiKey').value);
            event.target.textContent = 'Copied';
        });
    </script>

    <a href="/admin/partners" class="inline-block mt-6 text-sm text-zinc-500 hover:text-zinc-900">Done</a>
}

@code {
    [Parameter]
    public string ClientId { get; set; } = string.Empty;

    private AdminPartnerResponse? _partner;
    private CreatePartnerResult? _result;
    private string? _error;

    protected override async Task OnParametersSetAsync() =>
        _partner ??= await Admin.GetPartnerAsync(ClientId, CancellationToken.None);

    private async Task RotateAsync()
    {
        var (result, error) = await Admin.RotateKeyAsync(ClientId, CancellationToken.None);

        if (error is not null)
        {
            _error = error.Detail;
            return;
        }

        _result = result;
    }
}
