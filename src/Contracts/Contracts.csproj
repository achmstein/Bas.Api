<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Project directory is Contracts (src/ layout, mirroring PracticeManager.Api); the assembly
         and the published NuGet package carry the fully-qualified identity consumers reference. -->
    <AssemblyName>Bas.Api.Contracts</AssemblyName>
    <RootNamespace>Bas.Api.Contracts</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Bas.Api.Contracts</PackageId>
    <Description>Wire contracts for the Bas.Api partner REST surface.</Description>
    <Authors>achmstein</Authors>
    <RepositoryUrl>https://github.com/achmstein/Bas.Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Text.Json attributes only; no ASP.NET dependency, so a Flutter-side .NET tool or a
         console consumer can reference this without dragging in the web stack. -->
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

</Project>
