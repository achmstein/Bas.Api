<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Project directory is Contracts (src/ layout, mirroring PracticeManager.Api); the assembly
         and the published NuGet package carry the fully-qualified identity consumers reference. -->
    <AssemblyName>Bas.Api.Contracts</AssemblyName>
    <RootNamespace>Bas.Api.Contracts</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>Bas.Api.Contracts</PackageId>
    <Description>Wire contracts for the Bas.Api partner REST surface.</Description>
    <Authors>achmstein</Authors>
    <RepositoryUrl>https://github.com/achmstein/Bas.Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML docs ship with the package and are the partner documentation - but only where a
         member needs explaining. Self-describing fields (Id, PeriodStart, ...) are deliberately
         bare, so CS1591 would demand noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- No PackageReferences at all: System.Text.Json and DataAnnotations ship in the net10.0
       framework, and keeping this project dependency-free is what lets a console or Flutter-side
       .NET consumer reference it without dragging in the web stack. -->

</Project>
