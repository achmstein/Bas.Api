<Project>

  <!-- Repo-wide build settings. TargetFramework deliberately stays per-project: the Contracts
       package may plausibly multi-target one day, and the AppHost carries its own SDK element. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet's vulnerability audit stays a warning: a new advisory in a transitive dependency
         should show up loudly in the log, not brick an unrelated deploy. The current set is fixed
         (OpenTelemetry 1.18, MessagePack 2.5.302 - see Directory.Packages.props). -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
