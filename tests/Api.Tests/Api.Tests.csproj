<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Bas.Api.Tests</AssemblyName>
    <RootNamespace>Bas.Api.Tests</RootNamespace>

    <!-- xunit v3 runs on Microsoft.Testing.Platform: the test project is its own executable, and
         the .NET 10 SDK requires opting in explicitly before `dotnet test` will drive it. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- xUnit1051 wants TestContext.Current.CancellationToken threaded through every call that
         accepts a token - a cancellation-responsiveness nicety, not correctness. Two hundred call
         sites of churn for a suite that runs in ninety seconds is not a trade worth making. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- A real Postgres, not a stand-in. SQLite would run without a Docker daemon, but it cannot
         apply the migrations - only EnsureCreated, which builds the schema from the model and so
         leaves the migrations themselves untested - and it serialises writes, which silently turns
         the provisioning race test into a no-op. Both are exactly what this suite exists to cover. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
