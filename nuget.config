<?xml version="1.0" encoding="utf-8"?>
<!--
  PracticeManager.Api.Contracts lives on GitHub Packages, which is not a default source. Without
  this, a restore works on a developer machine that happens to have the feed registered globally
  and fails everywhere else - which is exactly how it failed the first CI run.

  No credentials here. GitHub Packages requires auth even for a public package, so CI adds them at
  run time from GITHUB_TOKEN and the container build mounts them as a BuildKit secret.

  The source key is GitHubPackages on purpose: NuGet matches stored credentials by KEY, so this is
  the name a developer machine already has credentials under. Naming it anything else means
  <clear/> removes the credentialed source and the restore quietly falls back to a stale package
  from the local cache instead of failing.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="GitHubPackages" value="https://nuget.pkg.github.com/achmstein/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Central Package Management requires each package to have exactly one home. Everything comes
       from nuget.org except this repo's own contract packages, which only exist on GitHub Packages.
       This also stops a nuget.org package squatting on those ids from ever being restored. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHubPackages">
      <package pattern="PracticeManager.Api.Contracts" />
      <package pattern="Bas.Api.Contracts" />
    </packageSource>
  </packageSourceMapping>
</configuration>
